# hal-aidl.bb.sample - reference BitBake recipe for the RDK HAL AIDL libraries.
#
# This is the recipe shape that tests/yocto/run-yocto.sh emulates
# offline. It is a *sample* (.bb.sample, not picked up by BitBake) - copy it
# into a layer as hal-aidl_<version>.bb and adjust SRC_URI / paths.
#
# Build model (see ../../README.md and ../../TWO_STAGE_BUILD.md):
#   - The Binder SDK comes from a separate `linux-binder` recipe; DEPENDS
#     pulls it into the sysroot. This recipe never builds the SDK itself.
#   - The committed module-local C++ is compiled directly; no Python and no
#     AIDL compiler are needed at image-build time for the snapshot path.
#     (The `all` build still runs the host AIDL tooling at configure time to
#     resolve the interface dependency graph.)

SUMMARY = "RDK HAL AIDL interface libraries"
LICENSE = "Apache-2.0"
LIC_FILES_CHKSUM = "file://LICENSE;md5=<fill-in>"

SRC_URI = "git://github.com/rdkcentral/rdk-halif-aidl.git;protocol=https;branch=main"
SRCREV = "<pin-to-a-release-tag-or-commit>"
S = "${WORKDIR}/git"

# The Binder SDK is staged by the linux-binder recipe.
DEPENDS = "linux-binder"

inherit cmake

# The SDK is staged FLAT under the sysroot prefix:
#   ${STAGING_DIR_HOST}${prefix}/include/binder_sdk
#   ${STAGING_DIR_HOST}${prefix}/lib/binder
# Both BINDER_SDK_DIR and BINDER_SDK_INCLUDE_DIR point at that prefix - in a
# local dev tree those two diverge (out/target vs out/build), so both must be
# passed explicitly.
EXTRA_OECMAKE = " \
    -DINTERFACE_TARGET=all \
    -DBINDER_SDK_DIR=${STAGING_DIR_HOST}${prefix} \
    -DBINDER_SDK_INCLUDE_DIR=${STAGING_DIR_HOST}${prefix} \
"

# do_configure / do_compile / do_install come from the cmake bbclass.
# CC / CXX / CFLAGS / CXXFLAGS / LDFLAGS are supplied by the Yocto
# environment and picked up by the build automatically.

# The HAL libraries install to ${libdir}/halif via the CMake install rules.
FILES:${PN} += "${libdir}/halif"

# Headers are build-time only and not needed on the target; package them
# into a separate -dev recipe/package if a development SDK is required.
