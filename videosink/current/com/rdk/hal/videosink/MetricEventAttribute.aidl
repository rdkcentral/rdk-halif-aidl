package com.rdk.hal.videosink;

/**
 * @brief     What describes an occurrence videosink raised.
 * @author    Gerald Weatherup
 *
 * THIS FILE IS GENERATED by scripts/kvcc.py from
 * videosink/kvc/videosink.kvc (schema 1). Do not edit:
 * declare the key there and regenerate, so an identifier is
 * declared in one place.
 */

/**
 * @brief What describes an occurrence videosink raised.
 *
 * An attribute locates and classifies an occurrence rather than measuring
 * it, so it has no kind. A value an occurrence measured does carry a kind.
 * Both appear in MetricEvent, in the array that says which it is, and share
 * one id space scoped by the element, in which 0 is
 * MetricGroup.ATTRIBUTE_INSTANCE.
 */

@VintfStability
@Backing(type="int")
enum MetricEventAttribute
{

    /**
     * `av.video_sink.underflow.trigger` — none. What caused this episode,
     * which is what distinguishes an expected starvation from a defect.
     */
    UNDERFLOW_TRIGGER = 1,

    /**
     * `av.video_sink.first_frame_presented.pts_ms` — ms. PTS of the frame
     * that reached presentation. Absent where the SoC cannot derive a PTS.
     */
    FIRST_FRAME_PRESENTED_PTS_MS = 3,

    /**
     * `av.video_sink.quality_threshold_crossed.metric` — none. Which counter
     * crossed its threshold.
     */
    QUALITY_THRESHOLD_CROSSED_METRIC = 4,

    /**
     * `av.video_sink.quality_threshold_crossed.pts_ms` — ms. Stream PTS at
     * the crossing. Absent where no PTS is derivable.
     */
    QUALITY_THRESHOLD_CROSSED_PTS_MS = 5,

    /**
     * `av.video_sink.underflow_end.duration_ms` — ms, current. Length of the
     * episode this closes, from start to resume. Not cumulative —
     * underflow_duration_ms carries the running total.
     */
    UNDERFLOW_END_DURATION_MS = 2,

    /**
     * `av.video_sink.quality_threshold_crossed.count` — frames, current. How
     * many frames the crossing covered.
     */
    QUALITY_THRESHOLD_CROSSED_COUNT = 6,
}
