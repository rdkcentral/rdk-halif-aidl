set(@MODULE_UPPER_NAME@_VERSION @MODULE_VERSION@)
@PACKAGE_INIT@

set_and_check(@MODULE_UPPER_NAME@_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set_and_check(@MODULE_UPPER_NAME@_LIBRARY "@PACKAGE_CMAKE_INSTALL_LIBDIR@/lib@MODULE_NAME@-v@MODULE_VERSION@-cpp.a")
set_and_check(@MODULE_UPPER_NAME@_SOURCE_DIR "@PACKAGE_CMAKE_INSTALL_PREFIX@/src")

set(@MODULE_UPPER_NAME@_LIBRARIES "@MODULE_DEPENDENCIES@")
set(@MODULE_UPPER_NAME@_SRC_FILES "@SRC_FILES@")
set(@MODULE_UPPER_NAME@_HEADER_FILES "@HEADER_FILES@")

check_required_components(@MODULE_UPPER_NAME@)
