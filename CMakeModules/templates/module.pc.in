prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@HALIF_INC_INSTALL@
srcdir=${prefix}/@HALIF_SRC_INSTALL@

Name: rdk-halif-aidl-@HALIF_COMP@-@HALIF_VER@
Description: RDK HAL AIDL @HALIF_COMP@ @HALIF_VER@ interface bindings
Version: @HALIF_VER@
URL: https://rdkcentral.github.io/rdk-halif-aidl
Requires: @HALIF_PC_REQUIRES@
Cflags: -I${includedir} @HALIF_PC_BINDER_CFLAGS@
Libs: -L${libdir} -l@HALIF_TGT@ @HALIF_PC_BINDER_LIBS@
