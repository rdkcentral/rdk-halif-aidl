@PACKAGE_INIT@

# @HALIF_PKG@ @HALIF_VER@ — generated by CMakeModules/HalifModule.cmake.

set(@HALIF_PKG@_VERSION "@HALIF_VER@")

list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/../rdk-halif-aidl")
include(CMakeFindDependencyMacro)
find_dependency(Binder)
@HALIF_FIND_DEPS@
include("${CMAKE_CURRENT_LIST_DIR}/@HALIF_PKG@Targets.cmake")

set_and_check(@HALIF_PKG@_INCLUDE_DIR "@PACKAGE_HALIF_INC_INSTALL@")
set_and_check(@HALIF_PKG@_SOURCE_DIR "@PACKAGE_HALIF_SRC_INSTALL@")
@HALIF_LIB_VARS@
# The library this component was built as: the .so, or the .a when it was
# built STATIC only.
set(@HALIF_PKG@_LIBRARIES RdkHalifAidl::@HALIF_PRIMARY@)

# Unversioned convenience name: the first version of this component found.
if(NOT TARGET RdkHalifAidl::@HALIF_COMP_CAP@)
    add_library(RdkHalifAidl::@HALIF_COMP_CAP@ ALIAS RdkHalifAidl::@HALIF_PRIMARY@)
endif()

check_required_components(@HALIF_PKG@)
