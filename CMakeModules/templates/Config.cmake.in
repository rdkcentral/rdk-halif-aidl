@PACKAGE_INIT@

# @HALIF_PKG@ @HALIF_VER@ — generated by CMakeModules/HalifModule.cmake.

set(@HALIF_PKG@_VERSION "@HALIF_VER@")

list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/../rdk-halif-aidl")
