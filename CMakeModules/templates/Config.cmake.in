# Unversioned convenience name: the first version of this component found.
if(NOT TARGET RdkHalifAidl::@HALIF_COMP_CAP@)
    add_library(RdkHalifAidl::@HALIF_COMP_CAP@ ALIAS RdkHalifAidl::@HALIF_TGT@)
endif()

