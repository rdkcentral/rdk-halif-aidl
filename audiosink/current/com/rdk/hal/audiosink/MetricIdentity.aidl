package com.rdk.hal.audiosink;

/**
 * @brief     What each audiosink metric id means.
 * @author    Gerald Weatherup
 *
 * THIS FILE IS GENERATED by scripts/kvcc.py from
 * audiosink/kvc/audiosink.kvc (schema 1). Do not edit:
 * declare the key there and regenerate, so an identifier is
 * declared in one place.
 */

/**
 * @brief What each audiosink metric id means.
 *
 * One constant per key and per event field, holding the path, unit and, for
 * a measurement, kind its id stands for. It exists so the AIDL compatibility
 * check can see them: a frozen constant's value cannot change, so a field
 * whose unit or kind changes is refused and must take a new id. Nothing is
 * served through it. KEY_<NAME> describes Metric::<NAME>, and
 * ATTRIBUTE_<NAME> describes MetricEventAttribute::<NAME>.
 */

@VintfStability
parcelable MetricIdentity
{

    /**
     * `av.audio_sink.underflowed|episodes|counter`
     */
    const String KEY_UNDERFLOWED = "av.audio_sink.underflowed|episodes|counter";

    /**
     * `av.audio_sink.underflow_duration_ms|ms|counter`
     */
    const String KEY_UNDERFLOW_DURATION_MS = "av.audio_sink.underflow_duration_ms|ms|counter";

    /**
     * `av.audio_sink.silence_duration_ms|ms|counter`
     */
    const String KEY_SILENCE_DURATION_MS = "av.audio_sink.silence_duration_ms|ms|counter";

    /**
     * `av.audio_sink.silence_event_count|events|counter`
     */
    const String KEY_SILENCE_EVENT_COUNT = "av.audio_sink.silence_event_count|events|counter";

    /**
     * `av.audio_sink.buffer_depth_ms|ms|current`
     */
    const String KEY_BUFFER_DEPTH_MS = "av.audio_sink.buffer_depth_ms|ms|current";

    /**
     * `av.audio_sink.last_underflow_trigger|none|current`
     */
    const String KEY_LAST_UNDERFLOW_TRIGGER = "av.audio_sink.last_underflow_trigger|none|current";

    /**
     * `av.audio_sink.last_underflow_duration_ms|ms|current`
     */
    const String KEY_LAST_UNDERFLOW_DURATION_MS = "av.audio_sink.last_underflow_duration_ms|ms|current";

    /**
     * `av.audio_sink.last_silence_duration_ms|ms|current`
     */
    const String KEY_LAST_SILENCE_DURATION_MS = "av.audio_sink.last_silence_duration_ms|ms|current";

    /**
     * `av.audio_sink.silence_threshold_ms|ms|config`
