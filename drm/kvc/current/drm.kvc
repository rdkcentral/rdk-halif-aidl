# Key Value Contract for the decrypt path.
#
# THIS FILE IS THE CONTRACT for what this component measures. A vendor
# implements against the description on each key; a test suite asserts against
# it. AFTER EDITING, RUN: scripts/kvcc.py
#
# This vocabulary sits BESIDE the interface versions, never inside one, so a
# revision here moves no frozen interface hash.
#
# A key absent here is ABSENT at runtime — never 0, never -1. unit and kind are
# part of a key's identity. A counter is monotonic from resource creation and is
# never reset. Every value is int64.
#
# SCOPE IS WHAT THE DRIVER CAN OBSERVE: work done on keys the session already
# holds. A licence that was never obtained is a fact about the licence exchange
# rather than about the decrypt path, is not vendor-observable, and is not here.
#
# THIS IS NOT THE SAME SURFACE AS IDrmPlugin.getMetrics(). That returns
# DrmMetricGroup, which is vendor-defined and explicitly opaque to the
# framework: useful for vendor diagnosis, and impossible to compare across
# SoCs because nothing constrains the names or the units. The keys here are
# contracted, identified and comparable. Both exist, and they answer different
# questions.

format: kvc
schema: 1

domain: av
component: drm
package: drm
version: 1.0

# One instance per concurrent media session.
instances: 2

captureCadenceMs: 50

keys:

  # av.drm.decrypt_count
  - name: decrypt_count
    type: int64
    unit: operations
    kind: counter
    access: read
    provider: driver
    description: >
      Decrypt operations completed, summed across the key sessions this media
      session holds. The denominator for mean decrypt latency.

  # av.drm.decrypt_errors
  - name: decrypt_errors
    type: int64
    unit: events
    kind: counter
    access: read
    provider: driver
    description: >
      Decrypt operations that failed on a key already held. Distinct from a
      licence that was never obtained, which is not vendor-observable and is
      not counted here.

  # av.drm.decrypt_latency_sum_us
  - name: decrypt_latency_sum_us
    type: int64
    unit: us
    kind: counter
    access: read
    provider: driver
    description: >
      Sum of decrypt operation latency. Paired with decrypt_count, so the mean
      decrypt latency is this divided by that.
