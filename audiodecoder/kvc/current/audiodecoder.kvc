# Key Value Contract for the audio decoder.
#
# THIS FILE IS THE CONTRACT for what this component measures. A vendor
# implements against the description on each key; a test suite asserts against
# it. AFTER EDITING, RUN: scripts/kvcc.py
#
# This vocabulary sits BESIDE the interface versions, never inside one, so a
# revision here moves no frozen interface hash.
#
# A key absent here is ABSENT at runtime — never 0, never -1. unit and kind are
# part of a key's identity. A counter is monotonic from resource creation and is
# never reset on open(), flush(), stop() or seek. Every value is int64.
#
# This element mirrors av.video_decoder deliberately: the same four axes mean
# the same things on both, so a consumer computes a decode error rate the same
# way whichever it is reading.

format: kvc
schema: 1

domain: av
component: audio_decoder
package: audiodecoder
version: 1.0

instances: 2

keys:

  # av.audio_decoder.frames_decoded
  - name: frames_decoded
    type: int64
    unit: frames
    kind: counter
    access: read
    provider: driver
    description: >
      Audio access units decoded and emitted at the decoder output, one per
      emitted access unit. Counted from instance creation and never reset on
      flush or seek.

  # av.audio_decoder.frames_dropped
  - name: frames_dropped
    type: int64
    unit: frames
    kind: counter
    access: read
    provider: driver
    description: >
      Audio frames discarded before output, whether through an xrun or because
      they were undecodable. Decoder-internal, and excluded from
      frames_decoded.

  # av.audio_decoder.decode_errors
  - name: decode_errors
    type: int64
    unit: events
    kind: counter
    access: read
    provider: driver
    description: >
      Audio decode-error occurrences. A distinct axis from frames_dropped,
      exactly as on av.video_decoder: an error need not drop a frame, and a
      drop need not be an error.

  # av.audio_decoder.decode_latency_sum_us
  - name: decode_latency_sum_us
    type: int64
    unit: us
    kind: counter
    access: read
    provider: driver
    description: >
      Running sum of per-frame audio decode latency, from the access unit being
      queued at the input to the frame being emitted at the output. Paired with
      frames_decoded.

  # av.audio_decoder.last_decode_error_pts_ms
  - name: last_decode_error_pts_ms
    type: int64
    unit: ms
    kind: current
    access: read
    provider: driver
    description: >
      Stream PTS at detection of the most recent audio decode error, within one
      frame interval. Read with decode_errors. Left undeclared where no PTS is
      derivable, and never served as -1.

  # av.audio_decoder.last_decode_error_reason
  - name: last_decode_error_reason
    type: int64
    unit: none
    kind: current
    access: read
    provider: driver
    description: >
      Classification of the most recent audio decode error. This is the value a
      consumer branches on, and what makes the fault comparable across SoCs.
    values:
      - name: none
        value: 0
        description: No decode error has been recorded.
      - name: bitstream_error
        value: 1
        description: The coded bitstream was malformed or failed to parse.
      - name: unsupported_format
        value: 2
        description: >
          The stream is well formed but uses a tool, profile or level this
          decoder does not implement.
      - name: decoder_fault
        value: 3
        description: >
          The decoder failed internally on a stream it should have been able to
          decode.
      - name: resource_lost
        value: 4
        description: >
          A resource the decode depended on was withdrawn, such as a secure
          buffer or a hardware context reclaimed under pressure.
      - name: hardware_fault
        value: 5
        description: The decode hardware reported a fault.

  # av.audio_decoder.last_decode_error_vendor_code
  - name: last_decode_error_vendor_code
    type: int64
    unit: none
    kind: current
    access: read
    provider: driver
    description: >
      The SoC's own code for the same fault, carried through uninterpreted. For
      vendor diagnosis, and never branched on.

events:

  # av.audio_decoder.decode_error
  - name: decode_error
    description: >
      Raised at detection of a decode fault, once per fault. A fault that also
      discards a frame raises this and advances frames_dropped; a fault that
      does not raises this alone. The two are separate axes.
    attributes:

      # av.audio_decoder.decode_error.reason
      - name: reason
        type: int64
        unit: none
        description: >
          Classification of this fault, from the same closed vocabulary as
          last_decode_error_reason. The value a consumer branches on.
        values:
          - name: none
            value: 0
            description: No decode error has been recorded.
          - name: bitstream_error
            value: 1
            description: The coded bitstream was malformed or failed to parse.
          - name: unsupported_format
            value: 2
            description: >
              The stream is well formed but uses a tool, profile or level this
              decoder does not implement.
          - name: decoder_fault
            value: 3
            description: >
              The decoder failed internally on a stream it should have been
              able to decode.
          - name: resource_lost
            value: 4
            description: >
              A resource the decode depended on was withdrawn, such as a secure
              buffer or a hardware context reclaimed under pressure.
          - name: hardware_fault
            value: 5
            description: The decode hardware reported a fault.

      # av.audio_decoder.decode_error.vendor_code
      - name: vendor_code
        type: int64
        unit: none
        description: >
          The SoC's own error code for this fault, carried through
          uninterpreted. For vendor diagnosis, and never branched on.

      # av.audio_decoder.decode_error.pts_ms
      - name: pts_ms
        type: int64
        unit: ms
        description: >
          Stream PTS at detection, within one frame interval. Absent where the
          SoC cannot derive a PTS at all, and NOT_AVAILABLE where it can but
          could not at this instant. Never sent as -1.
