package com.rdk.hal.audiodecoder;

/**
 * @brief     What each audiodecoder metric id means.
 * @author    Gerald Weatherup
 *
 * THIS FILE IS GENERATED by scripts/kvcc.py from
 * audiodecoder/kvc/audiodecoder.kvc (schema 1). Do not edit:
 * declare the key there and regenerate, so an identifier is
 * declared in one place.
 */

/**
 * @brief What each audiodecoder metric id means.
 *
 * One constant per key and per event field, holding the path, unit and, for
 * a measurement, kind its id stands for. It exists so the AIDL compatibility
 * check can see them: a frozen constant's value cannot change, so a field
 * whose unit or kind changes is refused and must take a new id. Nothing is
 * served through it. KEY_<NAME> describes Metric::<NAME>, and
 * ATTRIBUTE_<NAME> describes MetricEventAttribute::<NAME>.
 */

@VintfStability
parcelable MetricIdentity
{

    /**
     * `av.audio_decoder.frames_decoded|frames|counter`
     */
    const String KEY_FRAMES_DECODED = "av.audio_decoder.frames_decoded|frames|counter";

    /**
     * `av.audio_decoder.frames_dropped|frames|counter`
     */
    const String KEY_FRAMES_DROPPED = "av.audio_decoder.frames_dropped|frames|counter";

    /**
     * `av.audio_decoder.decode_errors|events|counter`
     */
    const String KEY_DECODE_ERRORS = "av.audio_decoder.decode_errors|events|counter";

    /**
     * `av.audio_decoder.decode_latency_sum_us|us|counter`
     */
    const String KEY_DECODE_LATENCY_SUM_US = "av.audio_decoder.decode_latency_sum_us|us|counter";

    /**
     * `av.audio_decoder.last_decode_error_pts_ms|ms|current`
     */
    const String KEY_LAST_DECODE_ERROR_PTS_MS = "av.audio_decoder.last_decode_error_pts_ms|ms|current";

    /**
     * `av.audio_decoder.last_decode_error_reason|none|current`
     */
    const String KEY_LAST_DECODE_ERROR_REASON = "av.audio_decoder.last_decode_error_reason|none|current";

    /**
     * `av.audio_decoder.last_decode_error_vendor_code|none|current`
     */
    const String KEY_LAST_DECODE_ERROR_VENDOR_CODE = "av.audio_decoder.last_decode_error_vendor_code|none|current";

    /**
     * `av.audio_decoder.decode_error.reason|none`
     */
    const String ATTRIBUTE_DECODE_ERROR_REASON = "av.audio_decoder.decode_error.reason|none";

    /**
     * `av.audio_decoder.decode_error.vendor_code|none`
     */
    const String ATTRIBUTE_DECODE_ERROR_VENDOR_CODE = "av.audio_decoder.decode_error.vendor_code|none";

    /**
     * `av.audio_decoder.decode_error.pts_ms|ms`
     */
    const String ATTRIBUTE_DECODE_ERROR_PTS_MS = "av.audio_decoder.decode_error.pts_ms|ms";
}
