package com.rdk.hal.audiodecoder;

/**
 * @brief     The figures audiodecoder measures.
 * @author    Gerald Weatherup
 *
 * THIS FILE IS GENERATED by scripts/kvcc.py from
 * audiodecoder/kvc/audiodecoder.kvc (schema 1). Do not edit:
 * declare the key there and regenerate, so an identifier is
 * declared in one place.
 */

/**
 * @brief The figures audiodecoder measures.
 *
 * MetricValue.id carries one of these, scoped by the element in
 * MetricGroup.id. A key's name, unit and kind are its identity: once frozen,
 * an id never changes any of them, so a changed figure takes a new id rather
 * than a plausible wrong number answering to the old one.
 */

@VintfStability
@Backing(type="int")
enum Metric
{

    /**
     * `av.audio_decoder.frames_decoded` — frames, counter. Audio access units
     * decoded and emitted at the decoder output, one per emitted access unit.
     * Counted from instance creation and never reset on flush or seek.
     */
    FRAMES_DECODED = 1,

    /**
     * `av.audio_decoder.frames_dropped` — frames, counter. Audio frames
     * discarded before output, whether through an xrun or because they were
     * undecodable. Decoder-internal, and excluded from frames_decoded.
     */
    FRAMES_DROPPED = 2,

    /**
     * `av.audio_decoder.decode_errors` — events, counter. Audio decode-error
     * occurrences. A distinct axis from frames_dropped, exactly as on
     * av.video_decoder: an error need not drop a frame, and a drop need not
     * be an error.
     */
    DECODE_ERRORS = 3,

    /**
     * `av.audio_decoder.decode_latency_sum_us` — us, counter. Running sum of
     * per-frame audio decode latency, from the access unit being queued at
     * the input to the frame being emitted at the output. Paired with
     * frames_decoded.
     */
    DECODE_LATENCY_SUM_US = 4,

    /**
     * `av.audio_decoder.last_decode_error_pts_ms` — ms, current. Stream PTS
     * at detection of the most recent audio decode error, within one frame
     * interval. Read with decode_errors. Left undeclared where no PTS is
     * derivable, and never served as -1.
     */
    LAST_DECODE_ERROR_PTS_MS = 5,

    /**
     * `av.audio_decoder.last_decode_error_reason` — none, current.
     * Classification of the most recent audio decode error. This is the value
     * a consumer branches on, and what makes the fault comparable across
     * SoCs.
     */
    LAST_DECODE_ERROR_REASON = 6,

    /**
     * `av.audio_decoder.last_decode_error_vendor_code` — none, current. The
     * SoC's own code for the same fault, carried through uninterpreted. For
     * vendor diagnosis, and never branched on.
     */
    LAST_DECODE_ERROR_VENDOR_CODE = 7,
}
