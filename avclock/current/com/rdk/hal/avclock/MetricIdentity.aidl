package com.rdk.hal.avclock;

/**
 * @brief     What each avclock metric id means.
 * @author    Gerald Weatherup
 *
 * THIS FILE IS GENERATED by scripts/kvcc.py from
 * avclock/kvc/avclock.kvc (schema 1). Do not edit:
 * declare the key there and regenerate, so an identifier is
 * declared in one place.
 */

/**
 * @brief What each avclock metric id means.
 *
 * One constant per key and per event field, holding the path, unit and, for
 * a measurement, kind its id stands for. It exists so the AIDL compatibility
 * check can see them: a frozen constant's value cannot change, so a field
 * whose unit or kind changes is refused and must take a new id. Nothing is
 * served through it. KEY_<NAME> describes Metric::<NAME>, and
 * ATTRIBUTE_<NAME> describes MetricEventAttribute::<NAME>.
 */

@VintfStability
parcelable MetricIdentity
{

    /**
     * `av.clock.sync_offset_ms|ms|current`
     */
    const String KEY_SYNC_OFFSET_MS = "av.clock.sync_offset_ms|ms|current";

    /**
     * `av.clock.sync_max_abs_offset_ms|ms|high_water`
     */
    const String KEY_SYNC_MAX_ABS_OFFSET_MS = "av.clock.sync_max_abs_offset_ms|ms|high_water";

    /**
     * `av.clock.sync_time_over_threshold_ms|ms|counter`
     */
    const String KEY_SYNC_TIME_OVER_THRESHOLD_MS = "av.clock.sync_time_over_threshold_ms|ms|counter";

    /**
     * `av.clock.sync_threshold_ms|ms|config`
     */
    const String KEY_SYNC_THRESHOLD_MS = "av.clock.sync_threshold_ms|ms|config";

    /**
     * `av.clock.resync_count|events|counter`
     */
    const String KEY_RESYNC_COUNT = "av.clock.resync_count|events|counter";

    /**
     * `av.clock.resync_magnitude_sum_ms|ms|counter`
     */
    const String KEY_RESYNC_MAGNITUDE_SUM_MS = "av.clock.resync_magnitude_sum_ms|ms|counter";
}
